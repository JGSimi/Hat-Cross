{
  "name": "hat-cross",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "cd apps/hat-flash && PATH=\"$HOME/go/bin:$PATH\" wails3 dev -config ./build/config.yml",
    "build": "cd apps/hat-flash/frontend && npm run build && cd .. && PATH=\"$HOME/go/bin:$PATH\" wails3 build",
    "preview": "cd apps/hat-flash/frontend && npm run preview",
    "test": "npm --prefix apps/hat-flash/frontend test && cd apps/hat-flash && go test ./... && cd ../.. && npm run test:billing-worker",
    "test:billing-worker": "vitest run --config apps/hat-flash/billing-worker/vitest.config.ts && tsc -p apps/hat-flash/billing-worker/tsconfig.json",
    "test:billing-scripts": "node --test apps/hat-flash/billing-worker/scripts/*.test.mjs",
    "stripe:provision-catalog": "node apps/hat-flash/billing-worker/scripts/provision-stripe-catalog.mjs",
    "configure:billing-worker-secrets": "cd apps/hat-flash/billing-worker && node scripts/configure-worker-secrets.mjs",
    "dry-run:billing-worker": "cd apps/hat-flash/billing-worker && npx wrangler deploy --dry-run",
    "deploy:billing-worker": "cd apps/hat-flash/billing-worker && npx wrangler deploy",
    "dev:tauri": "vite",
    "build:tauri": "tsc && vite build",
    "preview:tauri": "vite preview",
    "tauri": "tauri",
    "test:tauri": "vitest run",
    "test:watch:tauri": "vitest",
    "test:coverage:tauri": "vitest run --coverage"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.8",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-http": "^2.5.7",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "firebase": "^12.12.0",
    "framer-motion": "^12.38.0",
    "i18next": "^26.0.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.14.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.5",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.5"
  }
}
