<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="hatflash"
        Arguments=""
        InstallLocation="C:\Program Files\JGSimi\Hat Flash">
    </Installer>
    <PackageInformation
        PackageName="HatFlash"
        PackageDisplayName="Hat Flash"
        PublisherName="CN=JGSimi"
        PublisherDisplayName="JGSimi"
        Version="0.1.0.0"
        PackageDescription="Hat Flash">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.hat.flash"
                Description="Hat Flash"
                DisplayName="Hat Flash"
                ExecutableName="hatflash"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Hat Flash</DisplayName>
            <PublisherDisplayName>JGSimi</PublisherDisplayName>
            <Description>Hat Flash</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="hatflash.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
