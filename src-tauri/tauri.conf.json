{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hat",
  "version": "2.25.1",
  "identifier": "com.hat.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Hat",
        "width": 820,
        "height": 650,
        "minWidth": 600,
        "minHeight": 500,
        "decorations": false,
        "transparent": false,
        "visible": true,
        "url": "/main"
      },
      {
        "label": "analysis",
        "title": "Hat - Análise de Tela",
        "width": 1000,
        "height": 700,
        "decorations": false,
        "transparent": false,
        "visible": false,
        "url": "/analysis"
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "Hat — AI Assistant"
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com https://api.inceptionlabs.ai https://openrouter.ai https://hat-proxy.joao02simi.workers.dev https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://www.googleapis.com https://oauth2.googleapis.com https://hat-cross.firebaseapp.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://lh3.googleusercontent.com; frame-ancestors 'none';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["hat"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/JGSimi/Hat-Cross/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCQTEwMjlGNUNCNTMwQTMKUldTak1MVmNud0toMnpJQjNXd2phZVNBWVFDeDU1Y04vZm5LcWJPQ3RDWjFqcnlNWFlaNXd2eUsK"
    }
  }
}
