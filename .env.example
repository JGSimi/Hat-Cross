# Copy to .env.local (gitignored) and fill in values.
# Required for the Hat credits system OAuth flow (Phase 2).

# Google OAuth 2.0 Desktop app credentials (from Google Cloud Console).
# The secret is not actually sensitive — Google's own docs state that for
# "Desktop app" client type, the secret is used only for rate-limiting and
# can safely ship embedded in the native binary.
VITE_GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-secret
