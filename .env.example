# Copy to .env.local (gitignored) and fill in values.
# Required for the Hat credits system OAuth flow (Phase 2).

# --- Google OAuth 2.0 Desktop app credentials (Google Cloud Console) ---
# The secret isn't really sensitive — Google's own docs say that for "Desktop
# app" client type, the secret is used only for rate-limiting the token
# endpoint and ships embedded in the native binary by design. Still kept out
# of git so forks have to supply their own.
VITE_GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
VITE_GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-secret

# --- Firebase Web config (Firebase Console → Project settings → Web app) ---
# Firebase docs mark these as client-safe identifiers (not secrets), but we
# still route them through env vars so the repo passes secret scanners and
# every fork has to plug in its own project.
VITE_FIREBASE_API_KEY=AIzaSy-your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef0123456789
